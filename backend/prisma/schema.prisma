generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==================== ENUMS ====================

enum UserRole {
  OWNER
  BUSINESS
  ORGANIZER
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum PetSize {
  MINI
  SMALL
  MEDIUM
  LARGE
  GIANT
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum PetType {
  DOG
  CAT
  RABBIT
  BIRD
  HAMSTER
  FISH
  TURTLE
  OTHER
}

enum BusinessCategory {
  VETERINARY
  EMERGENCY_CLINIC
  WALKER
  HOTEL
  DAYCARE
  STORE
  GROOMING
  TRAINER
  SHELTER
  OTHER
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  UPCOMING
  ACTIVE
  FINISHED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PromotionType {
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
  FREE_SERVICE
  BUNDLE
  OTHER
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum RouteDifficulty {
  EASY
  MODERATE
  HARD
}

enum WalkStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum TrafficLevel {
  LOW
  MEDIUM
  HIGH
}

enum CleanlinessLevel {
  DIRTY
  REGULAR
  CLEAN
}

enum ShadeLevel {
  NONE
  SOME
  PLENTY
}

enum SecurityLevel {
  LOW
  MEDIUM
  HIGH
}

// ==================== MODELS ====================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  avatarUrl     String?      @map("avatar_url")
  phone         String?
  city          String?
  district      String?
  role          UserRole     @default(OWNER)
  status        RecordStatus @default(ACTIVE)
  isActive      Boolean      @default(true) @map("is_active")
  googleId      String?      @unique @map("google_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  pets              Pet[]
  businesses        Business[]
  organizedEvents   Event[]            @relation("EventOrganizer")
  eventAttendances  EventAttendance[]
  eventInvitations  EventInvitation[]  @relation("InvitedUser")
  walks             Walk[]
  reviews           Review[]
  favorites         Favorite[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  notifications     Notification[]
  followedBy        Follow[]           @relation("Following")
  following         Follow[]           @relation("Follower")

  @@map("users")
}

model Pet {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String
  petType     PetType      @default(DOG) @map("pet_type")
  photoUrl    String?      @map("photo_url")
  breed       String?
  birthDate   DateTime?    @map("birth_date")
  size        PetSize?
  weight      Float?
  energyLevel EnergyLevel  @default(MEDIUM) @map("energy_level")
  allergies   String?
  status      RecordStatus @default(ACTIVE)
  createdBy   String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedBy   String?      @map("updated_by")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccines          PetVaccine[]
  eventAttendances  EventAttendance[]
  walks             Walk[]
  photos            Photo[]

  @@map("pets")
}

model PetVaccine {
  id        String   @id @default(uuid())
  petId     String   @map("pet_id")
  name      String
  date      DateTime
  nextDate  DateTime? @map("next_date")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_vaccines")
}

model Business {
  id            String             @id @default(uuid())
  ownerId       String             @map("owner_id")
  name          String
  description   String?
  category      BusinessCategory
  categories    BusinessCategory[] @default([])
  petTypes      PetType[]          @default([]) @map("pet_types")
  businessStatus BusinessStatus   @default(PENDING) @map("business_status")
  status        RecordStatus       @default(ACTIVE)
  phone         String?
  whatsapp      String?
  email         String?
  website       String?
  facebook      String?
  instagram     String?
  tiktok        String?
  address       String
  city          String
  district      String?
  latitude      Float
  longitude     Float
  is24Hours     Boolean            @default(false) @map("is_24_hours")
  isPetFriendly Boolean            @default(true) @map("is_pet_friendly")
  isVerified    Boolean            @default(false) @map("is_verified")
  priceRange    String?            @map("price_range")
  createdBy     String?            @map("created_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedBy     String?            @map("updated_by")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  owner       User               @relation(fields: [ownerId], references: [id])
  hours       BusinessHour[]
  services    BusinessService[]
  promotions  Promotion[]
  photos      Photo[]
  reviews     Review[]
  favorites   Favorite[]
  events      Event[]            @relation("EventBusiness")

  @@map("businesses")
}

model BusinessHour {
  id         String  @id @default(uuid())
  businessId String  @map("business_id")
  dayOfWeek  Int     @map("day_of_week")
  openTime   String  @map("open_time")
  closeTime  String  @map("close_time")
  isClosed   Boolean @default(false) @map("is_closed")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model BusinessService {
  id          String            @id @default(uuid())
  businessId  String            @map("business_id")
  category    BusinessCategory?
  name        String
  description String?
  price       Float?
  currency    String            @default("PEN")
  duration    Int?
  status      RecordStatus      @default(ACTIVE)
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedBy   String?           @map("updated_by")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_services")
}

// ==================== PROMOTIONS ====================

model Promotion {
  id          String        @id @default(uuid())
  businessId  String        @map("business_id")
  type        PromotionType
  title       String
  description String?
  discount    Float?        // percent or amount depending on type
  code        String?       // promo code if applicable
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  isActive    Boolean       @default(true) @map("is_active")
  status      RecordStatus  @default(ACTIVE)
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedBy   String?       @map("updated_by")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

// ==================== ADS (ready for future) ====================

model AdPlacement {
  id          String   @id @default(uuid())
  businessId  String?  @map("business_id")
  slot        String   // "home_banner", "directory_top", "map_featured", "event_sidebar"
  title       String
  description String?
  imageUrl    String?  @map("image_url")
  targetUrl   String?  @map("target_url")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  adStatus    AdStatus @default(DRAFT) @map("ad_status")
  status      RecordStatus @default(ACTIVE)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ad_placements")
}

// ==================== EVENTS ====================

model Event {
  id              String        @id @default(uuid())
  organizerId     String        @map("organizer_id")
  businessId      String?       @map("business_id")
  routeId         String?       @map("route_id")
  clonedFromId    String?       @map("cloned_from_id")
  title           String
  description     String?
  date            DateTime
  endDate         DateTime?     @map("end_date")
  meetingPoint    String        @map("meeting_point")
  meetingLat      Float         @map("meeting_lat")
  meetingLng      Float         @map("meeting_lng")
  endPoint        String?       @map("end_point")
  endLat          Float?        @map("end_lat")
  endLng          Float?        @map("end_lng")
  city            String
  district        String?
  maxAttendees    Int?          @map("max_attendees")
  price           Float         @default(0)
  currency        String        @default("PEN")
  isFree          Boolean       @default(true) @map("is_free")
  isPublic        Boolean       @default(true) @map("is_public")
  energyLevel     EnergyLevel?  @map("energy_level")
  recommendedSize PetSize[]     @map("recommended_size")
  requirements    String[]
  eventStatus     EventStatus   @default(UPCOMING) @map("event_status")
  status          RecordStatus  @default(ACTIVE)
  createdBy       String?       @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedBy       String?       @map("updated_by")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organizer   User               @relation("EventOrganizer", fields: [organizerId], references: [id])
  business    Business?          @relation("EventBusiness", fields: [businessId], references: [id])
  route       Route?             @relation(fields: [routeId], references: [id])
  clonedFrom  Event?             @relation("EventClone", fields: [clonedFromId], references: [id])
  clones      Event[]            @relation("EventClone")
  attendances EventAttendance[]
  invitations EventInvitation[]
  photos      Photo[]
  reviews     Review[]
  favorites   Favorite[]

  @@map("events")
}

model EventAttendance {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  petId     String   @map("pet_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
  pet   Pet   @relation(fields: [petId], references: [id])

  @@unique([eventId, userId, petId])
  @@map("event_attendances")
}

model EventInvitation {
  id        String           @id @default(uuid())
  eventId   String           @map("event_id")
  userId    String           @map("user_id")
  invStatus InvitationStatus @default(PENDING) @map("inv_status")
  message   String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("InvitedUser", fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_invitations")
}

// ==================== ROUTES & WALKS ====================

model Route {
  id          String          @id @default(uuid())
  creatorId   String          @map("creator_id")
  name        String
  description String?
  startLat    Float           @map("start_lat")
  startLng    Float           @map("start_lng")
  endLat      Float           @map("end_lat")
  endLng      Float           @map("end_lng")
  waypoints   Json
  distance    Float
  duration    Int
  difficulty  RouteDifficulty @default(EASY)
  city        String
  district    String?
  isPublic    Boolean         @default(true) @map("is_public")
  hasShade    Boolean         @default(false) @map("has_shade")
  hasWater    Boolean         @default(false) @map("has_water")
  hasRestArea Boolean         @default(false) @map("has_rest_area")
  timesWalked Int             @default(0) @map("times_walked")
  avgRating   Float           @default(0) @map("avg_rating")
  status      RecordStatus    @default(ACTIVE)
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedBy   String?         @map("updated_by")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  events    Event[]
  walks     Walk[]
  reviews   Review[]
  favorites Favorite[]
  photos    Photo[]

  @@map("routes")
}

model Walk {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  petId       String     @map("pet_id")
  routeId     String?    @map("route_id")
  walkStatus  WalkStatus @default(IN_PROGRESS) @map("walk_status")
  status      RecordStatus @default(ACTIVE)
  startedAt   DateTime   @default(now()) @map("started_at")
  finishedAt  DateTime?  @map("finished_at")
  distance    Float?
  duration    Int?
  trackPoints Json?      @map("track_points")
  rating      Int?
  comment     String?
  security    SecurityLevel?
  cleanliness CleanlinessLevel?
  shade       ShadeLevel?
  traffic     TrafficLevel?
  hasWater    Boolean?   @map("has_water")
  hasDogs     Boolean?   @map("has_dogs")
  createdBy   String?    @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedBy   String?    @map("updated_by")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
  pet    Pet     @relation(fields: [petId], references: [id])
  route  Route?  @relation(fields: [routeId], references: [id])
  photos Photo[]

  @@map("walks")
}

// ==================== CONTENT ====================

model Photo {
  id         String       @id @default(uuid())
  url        String
  publicId   String?      @map("public_id")
  caption    String?
  businessId String?      @map("business_id")
  eventId    String?      @map("event_id")
  routeId    String?      @map("route_id")
  walkId     String?      @map("walk_id")
  petId      String?      @map("pet_id")
  postId     String?      @map("post_id")
  status     RecordStatus @default(ACTIVE)
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  route    Route?    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  walk     Walk?     @relation(fields: [walkId], references: [id], onDelete: Cascade)
  pet      Pet?      @relation(fields: [petId], references: [id], onDelete: Cascade)
  post     Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Review {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  rating     Int
  comment    String?
  businessId String?      @map("business_id")
  eventId    String?      @map("event_id")
  routeId    String?      @map("route_id")
  status     RecordStatus @default(ACTIVE)
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedBy  String?      @map("updated_by")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  route    Route?    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  businessId String?      @map("business_id")
  eventId    String?      @map("event_id")
  routeId    String?      @map("route_id")
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  route    Route?    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@unique([userId, eventId])
  @@unique([userId, routeId])
  @@map("favorites")
}

model Post {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  content   String?
  location  String?
  latitude  Float?
  longitude Float?
  status    RecordStatus @default(ACTIVE)
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedBy String?      @map("updated_by")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos   Photo[]
  likes    PostLike[]
  comments PostComment[]

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String       @id @default(uuid())
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  content   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Notification {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean      @default(false) @map("is_read")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
