# Base de datos (PostgreSQL). En local, ambas URLs pueden ser la misma.
# En producción (Supabase): DATABASE_URL usa el pooler 6543 con pgbouncer=true&connection_limit=1
# y DIRECT_URL el pooler 5432 (lo usan db push y migraciones).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/huellago?schema=huellago"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/huellago?schema=huellago"

# JWT (genera valores largos y aleatorios)
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo"
JWT_REFRESH_EXPIRATION="7d"

# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL="http://localhost:3001"

# Puerto local
PORT=3000

# Opcionales (integraciones aún no activas en producción)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
GOOGLE_MAPS_API_KEY=""
