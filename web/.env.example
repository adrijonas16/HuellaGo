# URL de la API (incluye /api). Local: http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# URL pública del sitio (canonical, sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://huellago-sooty.vercel.app

# ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica.
# GA4 solo se carga si la persona acepta las cookies de analítica.
NEXT_PUBLIC_GA_ID=

# Email de contacto que aparece en el sitio y en los textos legales
NEXT_PUBLIC_CONTACT_EMAIL=hola@huellago.pe

# Redes sociales (URL completa). Vacío = no se muestran.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Datos del titular para la política de privacidad y los términos
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_RUC=
NEXT_PUBLIC_LEGAL_ADDRESS=
